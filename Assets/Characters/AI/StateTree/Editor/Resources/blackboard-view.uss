#blackboard-view {
    background-color: rgb(70, 70, 70);
    flex-grow: 1;
    flex-basis: 20%;
    border-left-color: rgb(22, 22, 22);
    border-right-color: rgb(22, 22, 22);
    border-top-color: rgb(22, 22, 22);
    border-bottom-color: rgb(22, 22, 22);
    border-right-width: 4px;
}

#blackboard-variable-view {
    flex-direction: row;
    background-color: rgb(53, 53, 53);
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(128, 128, 128);
    border-right-color: rgb(128, 128, 128);
    border-top-color: rgb(128, 128, 128);
    border-bottom-color: rgb(128, 128, 128);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

#blackboard-variable-field {
    background-color: rgb(41, 41, 41);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-left-color: rgb(195, 195, 195);
    border-right-color: rgb(195, 195, 195);
    border-top-color: rgb(195, 195, 195);
    border-bottom-color: rgb(195, 195, 195);
    flex-grow: 1;
    color: rgb(255, 255, 255);
}

#blackboard-view-title {
    font-size: 16px;
    -unity-text-align: upper-center;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
}

#blackboard-variable-button {
    align-self: flex-end;
    width: 16px;
    height: 16px;
}

#blackboard-variable-container {
    background-color: rgb(40, 40, 40);
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
}
