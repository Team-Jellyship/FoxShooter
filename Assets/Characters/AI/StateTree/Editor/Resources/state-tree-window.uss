#unity-text-input {
    color: rgb(255, 255, 255);
    margin-top: 0;
    margin-right: 4px;
    margin-bottom: 0;
    margin-left: 4px;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    height: 100%;
    width: 100%;
    background-color: rgba(0, 0, 0, 0);
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
}

#toolbar Button {
    background-color: rgb(60, 60, 60);
    border-top-left-radius: 0;
    border-top-right-radius: 0;
    border-bottom-right-radius: 0;
    border-bottom-left-radius: 0;
    border-top-width: 0;
    border-right-width: 0;
    border-bottom-width: 0;
    border-left-width: 0;
    color: rgb(255, 255, 255);
    height: 16px;
    flex-shrink: 0;
}

#primary-window {
    flex-direction: row;
}

#blackboard-view {
    background-color: rgb(70, 70, 70);
    flex-grow: 1;
    flex-basis: 40%;
}

#tree-view {
    flex-grow: 2;
    flex-basis: 60%;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}

StateView {
    flex-direction: column;
    color: rgb(255, 255, 255);
    margin-top: 8px;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 8px;
    font-size: 20px;
}

.selected {
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
}

StateView #title {
    background-color: rgb(183, 11, 59);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 4px;
    padding-right: 4px;
    padding-bottom: 4px;
    padding-left: 4px;
}

StateView #tasks-label {
    background-color: rgb(132, 23, 54);
    flex-grow: 0;
    padding-top: 8px;
    padding-right: 8px;
    padding-bottom: 8px;
    padding-left: 8px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    -unity-text-align: middle-left;
}

StateView #result-label {
}

StateView #state-container {
    flex-direction: row;
}

StateView #child-state-container {
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 16px;
}

#blackboard-variable-view {
    flex-direction: row;
    background-color: rgb(53, 53, 53);
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(128, 128, 128);
    border-right-color: rgb(128, 128, 128);
    border-top-color: rgb(128, 128, 128);
    border-bottom-color: rgb(128, 128, 128);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

#blackboard-variable-field {
    background-color: rgb(41, 41, 41);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-left-color: rgb(195, 195, 195);
    border-right-color: rgb(195, 195, 195);
    border-top-color: rgb(195, 195, 195);
    border-bottom-color: rgb(195, 195, 195);
    flex-grow: 1;
    color: rgb(255, 255, 255);
}

#blackboard-variable-name {
    flex-grow: 1;
}

#state-inspector {
    flex-basis: 25%;
    background-color: rgb(41, 41, 41);
}

#state-name-label {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-text-align: upper-center;
}
