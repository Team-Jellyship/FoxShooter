#state-inspector {
    flex-basis: 25%;
    background-color: rgb(41, 41, 41);
}

#state-name-label {
    color: rgb(255, 255, 255);
    font-size: 24px;
    -unity-text-align: upper-center;
}

#task-adder {
    width: 25px;
    align-self: flex-end;
}

#task-title {
    font-size: 16px;
    -unity-text-align: upper-center;
    border-bottom-width: 2px;
    border-left-color: rgb(0, 0, 0);
    border-right-color: rgb(0, 0, 0);
    border-top-color: rgb(0, 0, 0);
    border-bottom-color: rgb(0, 0, 0);
    padding-top: 16px;
}

GenericField {
    flex-direction: row;
    background-color: rgb(53, 53, 53);
    margin-top: 4px;
    margin-right: 4px;
    margin-bottom: 4px;
    margin-left: 4px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(128, 128, 128);
    border-right-color: rgb(128, 128, 128);
    border-top-color: rgb(128, 128, 128);
    border-bottom-color: rgb(128, 128, 128);
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
    border-bottom-right-radius: 8px;
    border-bottom-left-radius: 8px;
}

#generic-field-input {
    width: 100%;
}

#generic-field-input .unity-base-field__input {
    background-color: rgb(41, 41, 41);
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    border-bottom-right-radius: 4px;
    border-bottom-left-radius: 4px;
    border-left-color: rgb(195, 195, 195);
    border-right-color: rgb(195, 195, 195);
    border-top-color: rgb(195, 195, 195);
    border-bottom-color: rgb(195, 195, 195);
    flex-grow: 1;
    color: rgb(255, 255, 255);
}

#generic-field-input .unity-object-field__input {
    margin-right: 4px;
    border-left-color: rgba(0, 0, 0, 0);
    border-right-color: rgba(0, 0, 0, 0);
    border-top-color: rgba(0, 0, 0, 0);
    border-bottom-color: rgba(0, 0, 0, 0);
}
